{
  "name": "site-doors-website",
  "main": ".open-next/worker.js",
  "tail_consumers": [{ "service": "aapastech-security-log-tail" }],
  "compatibility_date": "2025-04-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "kv_namespaces": [
    { "binding": "NEXT_INC_CACHE_KV", "id": "1cce3dd189684678b2cafcdf93ab9cea" }
  ],
  "services": [
    { "binding": "WORKER_SELF_REFERENCE", "service": "site-doors-website" }
  ],
  "durable_objects": {
    "bindings": [{ "name": "NEXT_CACHE_DO_QUEUE", "class_name": "DOQueueHandler" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DOQueueHandler"] }]
}